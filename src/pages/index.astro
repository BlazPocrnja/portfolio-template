---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero';
import AboutSection from '@/components/AboutSection.astro';
import ProjectsList from '@/components/ProjectsList';
import ContactSection from '@/components/ContactSection.astro';
import Footer from '@/components/Footer.astro';
import ScrollProgress from '@/components/ScrollProgress';
import { projects } from '@/data/projects';

const sections = [
  { id: 'about', label: 'About' },
  { id: 'work', label: 'Work' },
  { id: 'contact', label: 'Contact' },
];
---
<Layout title="Your Name, Creative Developer">
  <ScrollProgress client:load sections={sections} />

  <Hero client:load />

  <AboutSection />

  <section class="section-pad" id="work">
    <h2 class="section-heading">Selected Work</h2>
    <ProjectsList client:visible projects={projects} />
  </section>

  <ContactSection />
  <Footer />
</Layout>

<style>
  .section-heading {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-dim);
    margin-bottom: 1rem;
  }
</style>

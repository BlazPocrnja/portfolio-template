---
import ScrollReveal from './ScrollReveal';
---
<section class="about section-pad" id="about">
  <ScrollReveal client:visible as="div" className="about-text">
    As a <span class="other-accent">creative developer</span>, I craft tailor-made web
    experiences, blending technical precision and <span class="other-accent">emotion</span>.
  </ScrollReveal>

  <ScrollReveal client:visible as="p" className="about-sub" delay={0.1}>
    My name is Your Name. A passionate creator and developer, I build memorable digital
    experiences, always seeking the symbiosis between art and information.
  </ScrollReveal>

  <a href="/info" class="about-btn">More about me →</a>

  <div class="about-photo-wrap">
    <img
      class="about-photo"
      src="https://picsum.photos/seed/profile/800/1000"
      alt="Portrait placeholder"
      width="800"
      height="1000"
      loading="lazy"
    />
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: clamp(4rem, 10vw, 8rem);
    padding-bottom: clamp(4rem, 10vw, 8rem);
    align-items: start;
  }
  :global(.about-text) {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 1.25rem;
  }
  :global(.about-sub) {
    color: var(--fg-dim);
    max-width: 46ch;
    margin: 0 0 1.5rem;
  }
  .about-btn {
    display: inline-block;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--fg);
    padding-bottom: 0.15rem;
  }
  .about-photo-wrap {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
  }
  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>

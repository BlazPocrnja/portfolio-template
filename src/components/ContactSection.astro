---
import ScrollReveal from './ScrollReveal';

interface Props {
  // Embedded on the homepage, Hero's name already carries the page's <h1>, so
  // this section is an <h2> there. Standalone on /contact there is no other
  // heading on the page, so that route passes 'h1' instead.
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---
<section class="contact section-pad" id="contact">
  <Heading class="contact-title">Contact</Heading>

  <ScrollReveal client:visible as="p" className="contact-dispo">
    Looking for an <span class="other-accent">apprenticeship / role</span> starting soon.
    Eager to join a team and contribute to ambitious projects.
  </ScrollReveal>

  <ScrollReveal client:visible as="p" className="contact-dispo" delay={0.1}>
    I'm available for <span class="other-accent">freelance work worldwide</span>, on{' '}
    <span class="other-accent">ambitious projects</span> and collaborations.
  </ScrollReveal>

  <div class="contact-bottom">
    <nav class="contact-socials" aria-label="Social links">
      <a href="https://github.com/BlazPocrnja" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/blaz-pocrnja" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
    <a class="contact-mail" href="mailto:bpocrnja@gmail.com">bpocrnja@gmail.com</a>
  </div>
</section>

<style>
  .contact {
    padding-top: clamp(4rem, 12vw, 9rem);
    padding-bottom: clamp(4rem, 12vw, 9rem);
    border-top: 1px solid var(--line);
  }
  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.005em;
    margin-bottom: 2rem;
  }
  :global(.contact-dispo) {
    max-width: 40ch;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }
  .contact-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 3rem;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--font-mono);
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .contact-socials {
    display: flex;
    gap: 1.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .contact-mail {
    position: relative;
    font-size: 1rem;
  }
  /* Invisible hit-area expansion (see global.css's .chr-hover::before for the
     same pattern) — these links aren't wrapped in HoverLink like Hero's/
     Footer's socials, so they need their own. 1.5rem/1rem gaps in this row
     give enough room for -8px on every side without adjacent links overlapping. */
  .contact-socials a {
    position: relative;
  }
  .contact-socials a::before,
  .contact-mail::before {
    content: '';
    position: absolute;
    inset: -8px;
  }
</style>
